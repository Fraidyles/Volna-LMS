# ---------- Сервер ----------
PORT=8790
NODE_ENV=production
# Домены фронтенда через запятую (без слэша на конце), кому разрешено обращаться к API
ALLOWED_ORIGINS=https://edu.вашдомен.ру,http://localhost:5500
# Опционально: смонтировать платформу в подпапку существующего сайта, например
# https://корп-домен.ру/lms/ — вместо отдельного (под)домена (когда нет возможности
# завести новую DNS-запись). Без слэша на конце, например /lms. Оставьте пустым,
# если платформа живёт в корне своего (под)домена — обычный случай из README.
BASE_PATH=

# ---------- База данных ----------
# Формат: postgres://пользователь:пароль@хост:5432/имя_базы
DATABASE_URL=postgres://lms_user:password@localhost:5432/lms
# true — если провайдер БД требует SSL (обычно для managed-баз вроде Render/Railway)
PGSSL=false

# ---------- Авторизация ----------
# Длинная случайная строка, которой подписываются токены входа. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=замените_на_длинную_случайную_строку

# ---------- Первый главный администратор ----------
# Создаётся один раз командой "npm run seed". После первого входа можно
# менять пароль обычным способом (эндпоинт смены пароля — в следующем этапе).
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=замените_на_надёжный_пароль
BOOTSTRAP_ADMIN_NAME=Главный администратор
